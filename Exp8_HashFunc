--------------------------------------------------------------------------------Secure hash:
#include <stdio.h>

unsigned long secureHash(char input[], unsigned long hash)
{
    for(int i = 0; input[i] != '\0'; i++)
    {
        hash ^= ((hash << 5) + (hash >> 2)) + input[i];
    }

    return hash;
}

int main()
{
    char input[200];

    unsigned long initialHash;

    printf("Enter a string: ");

    gets(input);

    printf("Enter initial hash value (number): ");

    scanf("%lu", &initialHash);

    printf("Secure Hash Value: %lx\n",
           secureHash(input, initialHash));

    return 0;
}
