#include <stdio.h>
#include <string.h>

unsigned long getHash(char input[], unsigned long hash)
{
    for(int i = 0; input[i] != '\0'; i++)
    {
        hash = ((hash << 5) + hash) + input[i];
    }

    return hash;
}

int main()
{
    char input[100];

    unsigned long hash;

    printf("Enter string: ");

    gets(input);

    printf("Enter initial hash: ");

    scanf("%lu", &hash);

    printf("Hash: %lu\n", getHash(input, hash));

    return 0;
}



